{
  "name": "@fusescope/browser",
  "version": "0.2.0-beta.0",
  "description": "FuseScope Real User Monitoring for the browser: a thin OpenTelemetry distribution",
  "license": "Apache-2.0",
  "author": "FuseOne",
  "homepage": "https://github.com/fuseone-io/fusescope-sdk/tree/main/packages/browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuseone-io/fusescope-sdk.git",
    "directory": "packages/browser"
  },
  "bugs": "https://github.com/fuseone-io/fusescope-sdk/issues",
  "keywords": [
    "fusescope",
    "rum",
    "opentelemetry",
    "browser",
    "web-vitals",
    "observability"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/fusescope.min.js",
  "jsdelivr": "./dist/fusescope.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fusescope.min.js": "./dist/fusescope.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepack": "cp ../../NOTICE NOTICE"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/browser-instrumentation": "0.8.2",
    "@opentelemetry/browser-sdk": "0.5.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
